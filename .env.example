# VTC Karim — variables d'environnement
# Copie ce fichier en .env.local et renseigne tes clés pour activer Stripe.
# Sans STRIPE_SECRET_KEY : mode DÉMO (le paiement est simulé, aucun appel Stripe).
#
# En PROD (Render), ces variables sont définies dans le dashboard Render
# (ou via render.yaml). TURSO_URL active automatiquement le store libSQL.

# Stripe (laisse vide pour le mode démo)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE=
STRIPE_WEBHOOK_SECRET=

# Secret de signature des sessions (généré par Render en prod, change-le)
AUTH_SECRET=change-me-in-prod

# Mot de passe de l'espace chauffeur (/chauffeur)
DRIVER_PASSWORD=change-me

# Base Turso (libSQL) — si TURSO_URL est défini, le store bascule sur Turso.
TURSO_URL=
TURSO_TOKEN=

# URL publique de l'app (utilisé pour les LiP de retour Stripe en prod)
APP_URL=http://localhost:3000
